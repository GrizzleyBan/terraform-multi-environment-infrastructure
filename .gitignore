
# Terraform working directories
**/.terraform/*

# Terraform state files and backups
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform saved plans
*.tfplan
*.tfplan.*
tfplan
tfplan.*

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment and credential files
.env
.env.*
*.pem
*.key

# macOS files
.DS_Store

# Editor files
.vscode/
.idea/
